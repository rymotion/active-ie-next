# Copy this file to .env.local for local development. Never commit real values.

# Zapier webhook that receives contrast therapy inquiry submissions.
# Server-only (no NEXT_PUBLIC_ prefix) — never expose this URL to the client.
ZAPIER_CONTRAST_INQUIRY_WEBHOOK_URL=https://hooks.zapier.com/hooks/catch/XXXXXXX/XXXXXXX/

# API key used when fetching Substack articles.
SUBSTACK_API_KEY=your-substack-api-key

# Shopify Storefront API. The URL is the full GraphQL endpoint for the store.
# Storefront tokens are public by design (safe with NEXT_PUBLIC_ prefix).
NEXT_PUBLIC_SHOPIFY_STOREFRONT_URL=https://your-store.myshopify.com/api/2025-01/graphql.json
NEXT_PUBLIC_SHOPIFY_STOREFRONT_KEY=your-storefront-access-token

# Shopify Admin API. Server-only — never expose to the client.
SHOPIFY_ADMIN_API_KEY=your-admin-api-key
SHOPIFY_ADMIN_API_SECRET=your-admin-api-secret

# Canonical site origin, used for metadata, sitemap, and hreflang alternates.
NEXT_PUBLIC_BASE_URL=https://activeie.org

# Shared secret that authorizes Vercel cron requests to /api/cron/* routes.
# Generate with: openssl rand -hex 32
CRON_SECRET=

# Instagram Graph API long-lived access token for @actv_ie. Server-only.
IG_ACCESS_TOKEN=

# Supabase (IG token storage + funding snapshots). Service role key is server-only.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
